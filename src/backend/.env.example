# Copy to .env and replace placeholders. scripts/setup_local.py generates local secrets.
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://night_voyage:replace-with-a-random-local-password@127.0.0.1:55432/night_voyage
APP_SECRET=replace-with-at-least-32-random-characters
APP_ENV=development
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
STORAGE_DIR=./runtime/private
COOKIE_SECURE=false
CRAWL_RETENTION_DAYS=30
CHAT_RATE_LIMIT=20

# Optional: auto-crawl and copilot model gateway (OpenAI-compatible).
# Leave the model variables blank to disable crawl and chat.
# ADMISSION_SOURCES_FILE=../config/admission_sources.json
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_OUTPUT_TOKENS=4000
