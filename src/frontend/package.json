{
  "name": "night-voyage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.26.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test ../../test/frontend/*.test.ts",
    "contract": "node scripts/contract.mjs",
    "contract:check": "node scripts/contract.mjs --check",
    "standalone": "node scripts/standalone.mjs",
    "format": "prettier --write src ../../test/frontend scripts vite.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
