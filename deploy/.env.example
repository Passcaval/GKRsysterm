POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://night_voyage:replace-with-a-long-random-password@postgres:5432/night_voyage
APP_SECRET=replace-with-at-least-32-random-characters
APP_ENV=development
ALLOWED_ORIGINS=["http://localhost:8080"]
COOKIE_SECURE=false
STORAGE_DIR=/app/runtime/private
HTTP_PORT=8080
CRAWL_RETENTION_DAYS=30
CHAT_RATE_LIMIT=20

# Optional: auto-crawl and copilot model gateway (OpenAI-compatible).
# Leave the model variables blank to disable crawl and chat.
# ADMISSION_SOURCES_FILE=/app/config/admission_sources.json
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_OUTPUT_TOKENS=4000

# DeepSeek Search/Fetch uses MODEL_API_KEY; no additional search key.
ADMISSION_KNOWLEDGE_ENABLED=true
ADMISSION_KNOWLEDGE_AUTO_SYNC=true
ADMISSION_KNOWLEDGE_TTL_HOURS=24
ADMISSION_KNOWLEDGE_TIMEOUT_SECONDS=20
ADMISSION_KNOWLEDGE_RESULTS=5
